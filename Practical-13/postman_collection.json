    {
      "name": "8. Test E.2: Rate Limit - Immediate Second Request (429)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Second rapid request returns 429 Too Many Requests', function () {",
              "    pm.response.to.have.status(429);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Contains Retry-After header and message', function () {",
              "    pm.expect(jsonData.message).to.include('Rate limit exceeded');",
              "    pm.expect(jsonData).to.have.property('retryAfter');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
