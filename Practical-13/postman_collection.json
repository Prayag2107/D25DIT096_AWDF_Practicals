    {
      "name": "6. Test D: Graceful Degradation / Status Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Reports service metadata without leaking secret key', function () {",
              "    pm.expect(jsonData).to.have.property('service');",
              "    pm.expect(jsonData).to.have.property('configured');",
              "    pm.expect(JSON.stringify(jsonData)).to.not.include('sk-');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ai/status",
          "host": ["{{baseUrl}}"],
          "path": ["ai", "status"]
        }
      }
    },
